{
  "name": "aljamicerdas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server tests scripts docs *.json *.md *.ts index.html",
    "format:check": "prettier --check src server tests scripts docs *.json *.md *.ts index.html",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@phosphor-icons/react": "2.1.10",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "gh-pages": "^6.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
